{
  "name": "@internal/rite-roman1962",
  "version": "0.0.0",
  "description": "Liturgical calendar for the Roman Rite according to the 1962 Tridentine calendar",
  "license": "MIT",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/esm/romcal.js",
    "require": "./dist/cjs/romcal.js"
  },
  "main": "dist/cjs/romcal.js",
  "module": "dist/esm/romcal.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/esm/romcal.js --platform=neutral --main-fields=main,module --target=ESNext --sourcemap && esbuild src/index.ts --bundle --format=cjs --outfile=dist/cjs/romcal.js --platform=node --target=ES2022 --sourcemap",
    "clean": "rimraf coverage dist",
    "data:checks": "tsx build/data-checks.ts",
    "test": "TZ=UTC jest --coverage",
    "test:snapshot:update": "TZ=UTC jest -u",
    "test:watch": "TZ=UTC jest --watch",
    "test:without-coverage": "TZ=UTC jest"
  },
  "dependencies": {
    "@internal/easter": "file:../../packages/easter"
  },
  "devDependencies": {
    "@internal/config": "file:../../packages/config",
    "@types/jest": "^30.0.0",
    "@types/node": "~24.10.1",
    "esbuild": "~0.27.0",
    "esbuild-jest": "~0.5.0",
    "jest-extended": "^4.0.2"
  }
}
